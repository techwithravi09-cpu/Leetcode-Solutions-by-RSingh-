class Solution(object):
    def rightSideView(self, root):
        ans=[]
        def reverse_post_order(root, level):
            if root is None:
                return
            if len(ans) == level:
                ans.append(root.val)
            if root.right:
                reverse_post_order(root.right, level + 1)
            if root.left:
                reverse_post_order(root.left, level + 1)

        reverse_post_order(root, 0)
        return ans
